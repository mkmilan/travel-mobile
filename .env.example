# Copy to .env.development. These settings are bundled into the app: no secrets.
APP_ENV=development
# Android emulator reaches host via 10.0.2.2. For a physical phone use a reachable
# development server on your LAN, never the production service.
API_URL=http://10.0.2.2:5001/api
# Optional for static/unit tests. Real Android maps need a restricted dev key.
GOOGLE_MAPS_KEY=

# Travel Test standalone APK uses APP_VARIANT=test and the fixed staging API.
# Supply only through an approved build environment; NEVER reuse a backend secret.
# This Android Maps key is embedded in the APK, so restrict it to the test package
# and the approved signing certificate SHA-1. Do not put a real key in this file.
# TEST_GOOGLE_MAPS_KEY=
